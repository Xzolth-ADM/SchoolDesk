<Window x:Class="SchoolDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SchoolDesk" Icon="/Assets/image_1_.ico" WindowStyle="None" WindowState="Maximized"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        KeyDown="Window_KeyDown">
    <!-- THESIS: Make the next school task obvious; refuse decorative glass and repeated navigation.
         OWN-WORLD: Matte Windows neutrals, a restrained blue accent, Segoe UI, 5px control corners.
         STORY: Read today's state, check the next lesson, and move to one school workflow.
         FIRST VIEWPORT: Fixed left navigation; date and task counts above a two-column dashboard.
         FORM: User-pinned light native Windows direction; the app's pages share one flat surface system. -->
    <Grid Background="{StaticResource WindowBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="238" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SubtleSurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="20,24,16,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="SchoolDesk" FontSize="23" FontWeight="SemiBold" />
                    <TextBlock Text="Espace scolaire" Foreground="{StaticResource MutedBrush}"
                               FontSize="13" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <Button x:Name="NavDashboard" Content="Tableau de bord" Click="Dashboard_Click"
                            Style="{StaticResource NavigationButtonStyle}" Foreground="{StaticResource AccentBrush}"
                            Background="{StaticResource AccentSubtleBrush}" Margin="0,0,0,5" />
                    <Button x:Name="NavAgenda" Content="Agenda" Click="OpenAgenda_Click"
                            Style="{StaticResource NavigationButtonStyle}" Margin="0,0,0,5" />
                    <Button x:Name="NavDocuments" Content="Documents" Click="OpenEditor_Click"
                            Style="{StaticResource NavigationButtonStyle}" Margin="0,0,0,5" />
                    <Button x:Name="NavExplorer" Content="Explorateur" Click="OpenExplorer_Click"
                            Style="{StaticResource NavigationButtonStyle}" Margin="0,0,0,5" />
                    <Button x:Name="NavNotes" Content="Notes rapides" Click="OpenNotes_Click"
                            Style="{StaticResource NavigationButtonStyle}" Margin="0,0,0,5" />
                    <Button x:Name="NavSettings" Content="Paramètres" Click="OpenSettings_Click"
                            Style="{StaticResource NavigationButtonStyle}" Margin="0,0,0,5" />
                </StackPanel>
                <StackPanel Grid.Row="3">
                    <TextBlock Text="Données conservées sur cet appareil"
                               Foreground="{StaticResource MutedBrush}" FontSize="12"
                               TextWrapping="Wrap" Margin="4,0,4,12" />
                    <Button Content="Réduire SchoolDesk" Click="ReduceButton_Click"
                            Style="{StaticResource NavigationButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="32,24,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="DateText" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock x:Name="WeekText" Foreground="{StaticResource MutedBrush}"
                               FontSize="13" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ClockText" FontSize="25" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,24,0" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="À faire " Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="TodoCountText" Text="0" Foreground="{StaticResource AccentBrush}"
                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <TextBlock Text="Terminées " Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="DoneCountText" Text="0" Foreground="#26734D"
                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,2,0" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <ContentControl x:Name="PageHost" Grid.Row="1">
                <Grid x:Name="DashboardPage" MaxWidth="1180"
                      HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="5" Padding="38">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="CurrentTitle" Text="Bienvenue dans SchoolDesk"
                                       FontSize="34" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Margin="0,0,0,8" />
                            <TextBlock x:Name="StateText" Text="INITIALISATION"
                                       Foreground="{StaticResource AccentBrush}" FontSize="13"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="CurrentDetails"
                                       Text="Le tableau de bord scolaire est prêt."
                                       FontSize="16" Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap" Margin="0,8,0,0" />
                            <TextBlock x:Name="RemainingText" Text="--:--" FontSize="54"
                                       FontWeight="Light" Margin="0,28,0,0" />
                            <Button x:Name="DashboardPrimaryButton" Content="Configurer mon emploi du temps"
                                    Click="DashboardPrimary_Click"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    HorizontalAlignment="Left" Margin="0,20,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="5" Padding="30">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Prochain cours" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock x:Name="NextTitle" Text="Aucun cours"
                                       FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Margin="0,18,0,8" />
                            <TextBlock x:Name="NextDetails" Foreground="{StaticResource MutedBrush}"
                                       FontSize="15" TextWrapping="Wrap" />
                            <TextBlock x:Name="NextCountdown" Foreground="{StaticResource AccentBrush}"
                                       FontSize="19" Margin="0,12,0,0" />
                            <TextBlock Text="Semaine A/B calculée automatiquement"
                                       Foreground="{StaticResource MutedBrush}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,28,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </ContentControl>
        </Grid>
    </Grid>
</Window>

<Window x:Class="SchoolDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SchoolDesk" WindowStyle="None" WindowState="Maximized"
        Background="#0010182C" Foreground="#F4F6FB" KeyDown="Window_KeyDown">
    <Grid>
      <Grid.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#A8111A30" Offset="0" />
            <GradientStop Color="#920B1020" Offset="0.55" />
            <GradientStop Color="#A81C2340" Offset="1" />
        </LinearGradientBrush>
      </Grid.Background>
      <Grid Margin="36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel LastChildFill="False">
            <StackPanel>
                <TextBlock Text="SCHOOLDESK" FontSize="13" FontWeight="Bold" Foreground="#9EABC0" />
                <TextBlock x:Name="DateText" FontSize="18" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                <TextBlock x:Name="ClockText" FontSize="36" FontWeight="Light" HorizontalAlignment="Right" />
                <TextBlock x:Name="WeekText" FontSize="13" Foreground="#9EABC0" HorizontalAlignment="Right" />
                <Border Background="#B52B3850" BorderBrush="#53627B" BorderThickness="1" CornerRadius="14" Padding="13,8" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="À FAIRE  " Foreground="#AAB5C7" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock x:Name="TodoCountText" Text="0" Foreground="#FFCF78" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="   FAIT  " Foreground="#AAB5C7" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock x:Name="DoneCountText" Text="0" Foreground="#8BE0B0" FontSize="17" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>

        <UniformGrid Grid.Row="1" Columns="6" Margin="0,18,0,14" HorizontalAlignment="Left">
            <Button Content="Tableau de bord" Click="Dashboard_Click" Margin="0,0,8,0" Background="#637FF0" Foreground="White"/>
            <Button Content="Agenda" Click="OpenAgenda_Click" Margin="0,0,8,0"/>
            <Button Content="Documents" Click="OpenEditor_Click" Margin="0,0,8,0"/>
            <Button Content="Explorateur" Click="OpenExplorer_Click" Margin="0,0,8,0"/>
            <Button Content="Notes rapides" Click="OpenNotes_Click" Margin="0,0,8,0"/>
            <Button Content="Paramètres" Click="OpenSettings_Click"/>
        </UniformGrid>
        <ContentControl x:Name="PageHost" Grid.Row="2">
        <Grid x:Name="DashboardPage" VerticalAlignment="Center" MaxWidth="1100" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource GlassSurfaceBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="28" Padding="38">
                <StackPanel>
                    <TextBlock x:Name="StateText" Text="INITIALISATION" Foreground="#9EABC0" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock x:Name="CurrentTitle" Text="Bienvenue dans SchoolDesk" FontSize="38" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,18,0,8" />
                    <TextBlock x:Name="CurrentDetails" Text="Le tableau de bord scolaire est prêt." FontSize="17" Foreground="#AAB5C7" />
                    <TextBlock x:Name="RemainingText" Text="--:--" FontSize="58" FontWeight="Light" Margin="0,36,0,0" />
                    <TextBlock Text="TEMPS RESTANT" FontSize="11" Foreground="#8290A6" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource GlassSurfaceBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="28" Padding="30">
                <StackPanel>
                    <TextBlock Text="PROCHAIN COURS" Foreground="#9EABC0" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock x:Name="NextTitle" Text="Aucun cours" FontSize="26" FontWeight="SemiBold" Margin="0,20,0,8" TextWrapping="Wrap" />
                    <TextBlock x:Name="NextDetails" Text="" FontSize="15" Foreground="#AAB5C7" TextWrapping="Wrap" />
                    <TextBlock x:Name="NextCountdown" Text="" FontSize="22" Foreground="#91AAFF" Margin="0,12,0,0" />
                    <Separator Margin="0,28,0,20" Background="#344054" />
                    <Button Content="Ouvrir l'agenda scolaire" Height="42" Click="OpenAgenda_Click"
                            Background="#637FF0" Foreground="White" BorderThickness="0" />
                    <Button Content="Documents · Éditeur Word" Height="40" Margin="0,8,0,0" Click="OpenEditor_Click" Background="#2B3A52" Foreground="White" BorderBrush="#52617A" />
                    <Button Content="Explorateur de documents" Height="38" Margin="0,8,0,0" Click="OpenExplorer_Click" Background="#2B3A52" Foreground="White" BorderBrush="#52617A" />
                    <Button Content="Notes rapides" Height="38" Margin="0,8,0,0" Click="OpenNotes_Click" Background="#2B3A52" Foreground="White" BorderBrush="#52617A" />
                    <Button Content="Paramètres" Height="38" Margin="0,8,0,0" Click="OpenSettings_Click" Background="#2B3A52" Foreground="White" BorderBrush="#52617A" />
                    <TextBlock Text="Alternance automatique · référence : 11 novembre 2026 = semaine A"
                               Foreground="#8290A6" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </Grid>
        </ContentControl>
        <DockPanel Grid.Row="3" LastChildFill="True" Margin="0,18,0,0">
            <TextBlock Text="Fonctionnement local · Les données restent sur cet ordinateur"
                       Foreground="#738198" FontSize="12" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Content="Réduire  ·  Échap" Width="160" Height="40"
                    Click="ReduceButton_Click" Background="#26344B" Foreground="#F4F6FB"
                    BorderBrush="#40516D" />
        </DockPanel>
      </Grid>
    </Grid>
</Window>

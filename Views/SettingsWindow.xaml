<UserControl x:Class="SchoolDesk.Views.SettingsWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" Foreground="{StaticResource TextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Paramètres" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,20" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="850" HorizontalAlignment="Left">
                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="Emploi du temps" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Personnalise tes cours, horaires et semaines A/B. Redémarre SchoolDesk après modification."
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,12" />
                    <Button Content="Ouvrir mon fichier d’emploi du temps" Click="OpenSchedule_Click"
                            HorizontalAlignment="Left" />
                </StackPanel>
                <Separator Margin="0,2,0,18" />
                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="Matières" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Utilisées dans l’agenda et le classement des documents."
                               Foreground="{StaticResource MutedBrush}" Margin="0,5,0,12" />
                    <DockPanel>
                        <TextBox x:Name="NewSubjectBox" DockPanel.Dock="Left" Width="320" />
                        <Button Content="Ajouter" Click="Add_Click" Margin="8,0,0,0"
                                Padding="14,5" />
                    </DockPanel>
                    <ListBox x:Name="SubjectsList" Height="190" Margin="0,12,0,0" />
                    <Button Content="Supprimer la matière sélectionnée" Click="Delete_Click"
                            Margin="0,10,0,0" HorizontalAlignment="Left" />
                </StackPanel>
                <Separator Margin="0,2,0,18" />
                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="Démarrage de Windows" FontSize="18" FontWeight="SemiBold" />
                    <CheckBox x:Name="StartupCheck"
                              Content="Lancer SchoolDesk à l’ouverture de ma session Windows"
                              Margin="0,12,0,0" Foreground="{StaticResource TextBrush}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center" />
            <Button Content="Annuler" Click="Close_Click" Width="110" Height="36"
                    DockPanel.Dock="Right" Margin="0,0,8,0" />
            <Button Content="Enregistrer" Click="Save_Click" Width="120" Height="36"
                    DockPanel.Dock="Right" Style="{StaticResource PrimaryButtonStyle}" />
        </DockPanel>
    </Grid>
</UserControl>

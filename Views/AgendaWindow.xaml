<UserControl x:Class="SchoolDesk.Views.AgendaWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" Foreground="{StaticResource TextBrush}">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Agenda" FontSize="28" FontWeight="SemiBold" />
                <TextBlock x:Name="StatusText" Text="Vos devoirs et échéances"
                           Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Matières" Click="Settings_Click" Margin="0,0,8,0" />
                <Button Content="Nouvelle tâche" Click="NewTask_Click"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Afficher" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                       Margin="0,0,10,0" />
            <ComboBox x:Name="ViewBox" Grid.Column="1" SelectedIndex="0"
                      SelectionChanged="View_Changed" Margin="0,0,16,0">
                <ComboBoxItem Content="Jour" />
                <ComboBoxItem Content="Semaine" />
                <ComboBoxItem Content="Mois" />
            </ComboBox>
            <TextBlock Grid.Column="2" Text="Date" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}" Margin="0,0,10,0" />
            <DatePicker x:Name="DayPicker" Grid.Column="3" SelectedDateChanged="DayPicker_Changed" />
            <TextBlock Grid.Column="4" Text="Coche les tâches terminées pour les marquer."
                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                       Margin="18,0,0,0" />
        </Grid>

        <Expander x:Name="NewTaskPanel" Grid.Row="2" Visibility="Collapsed"
                  IsExpanded="True" Margin="0,0,0,16">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="5" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.ColumnSpan="4" Text="Nouvelle tâche" FontSize="18"
                               FontWeight="SemiBold" Margin="0,0,0,12" />
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Text="Intitulé"
                               Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                    <TextBox x:Name="TitleBox" Grid.Row="2" Grid.ColumnSpan="4"
                             ToolTip="Intitulé" Margin="0,0,0,10" />
                    <TextBlock Grid.Row="3" Text="Catégorie" Foreground="{StaticResource MutedBrush}"
                               Margin="0,0,0,4" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Matière"
                               Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="Date"
                               Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="3" Grid.Column="3" Text="Heure"
                               Foreground="{StaticResource MutedBrush}" Margin="8,0,0,4" />
                    <ComboBox x:Name="TypeBox" Grid.Row="4" SelectedIndex="0" Margin="0,0,8,0">
                        <ComboBoxItem Content="Devoir" />
                        <ComboBoxItem Content="Évaluation" />
                        <ComboBoxItem Content="Cours" />
                        <ComboBoxItem Content="DM" />
                    </ComboBox>
                    <ComboBox x:Name="SubjectBox" Grid.Row="4" Grid.Column="1"
                              IsEditable="False" Margin="0,0,8,0" />
                    <DatePicker x:Name="DueDatePicker" Grid.Row="4" Grid.Column="2" />
                    <TextBox x:Name="TimeBox" Grid.Row="4" Grid.Column="3" Margin="8,0,0,0"
                             ToolTip="Facultatif · HH:mm" />
                    <TextBlock Grid.Row="5" Grid.ColumnSpan="4" Text="Description (facultative)"
                               Foreground="{StaticResource MutedBrush}" Margin="0,10,0,4" />
                    <TextBox x:Name="DescriptionBox" Grid.Row="6" Grid.ColumnSpan="4"
                             ToolTip="Description facultative" />
                    <Button Grid.Row="7" Grid.Column="3" Content="Ajouter" Click="Add_Click"
                            Style="{StaticResource PrimaryButtonStyle}" Margin="8,10,0,0" />
                    <Button Grid.Row="7" Grid.Column="2" Content="Annuler" Click="CancelNewTask_Click"
                            Margin="0,10,8,0" />
                </Grid>
            </Border>
        </Expander>

        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="5" Padding="16">
            <DockPanel>
                <TextBlock x:Name="RangeText" DockPanel.Dock="Top"
                           Foreground="{StaticResource MutedBrush}" Margin="2,0,0,12" />
                <Grid>
                    <TextBlock x:Name="EmptyState"
                               Text="Rien de prévu pour cette période. Ajoute une tâche pour commencer."
                               Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="24" />
                    <ListBox x:Name="AgendaList" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8F9FB" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="12"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="16"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding DisplaySubtitle}"
                                                       Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding DueDate, StringFormat={}{0:dddd d MMMM}}"
                                                       Foreground="{StaticResource AccentBrush}" Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding DisplayDate}"
                                                       Foreground="{StaticResource MutedBrush}" />
                                            <TextBlock Text="{Binding Description}"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1"
                                                  IsChecked="{Binding IsDone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Content="Terminée" VerticalAlignment="Center"
                                                  Foreground="{StaticResource TextBrush}"
                                                  Checked="Done_Changed" Unchecked="Done_Changed" Margin="12" />
                                        <Button Grid.Column="2" Content="Supprimer" Click="DeleteItem_Click"
                                                VerticalAlignment="Center" Padding="8,5" Tag="{Binding}"
                                                ToolTip="Supprimer cette tâche" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="4" Margin="2,12,2,0">
            <TextBlock Text="Enregistrement automatique · stockage local"
                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
            <Button Content="Tableau de bord" Width="140" Click="Close_Click"
                    DockPanel.Dock="Right" />
        </DockPanel>
    </Grid>
</UserControl>

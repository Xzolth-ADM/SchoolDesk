<UserControl x:Class="SchoolDesk.Views.AgendaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="Transparent" Foreground="#F5F7FF">
 <UserControl.Resources>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="#1B2540"/><Setter Property="Foreground" Value="#F5F7FF"/>
   <Setter Property="BorderBrush" Value="#52658E"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="9"/>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Background" Value="#1B2540"/><Setter Property="Foreground" Value="#F5F7FF"/>
   <Setter Property="BorderBrush" Value="#52658E"/><Setter Property="Padding" Value="7"/>
  </Style>
  <Style TargetType="DatePicker">
   <Setter Property="Background" Value="#1B2540"/><Setter Property="Foreground" Value="#F5F7FF"/>
  </Style>
 </UserControl.Resources>
 <Grid Margin="26">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,18">
   <StackPanel>
    <TextBlock Text="SCHOOLDESK  /  ORGANISATION" Foreground="#AAB8D8" FontSize="12" FontWeight="SemiBold"/>
    <TextBlock Text="Agenda" FontSize="30" FontWeight="SemiBold" Margin="0,4,0,0"/>
    <TextBlock x:Name="StatusText" Text="Vos devoirs et échéances" Foreground="#AAB8D8" Margin="0,3,0,0"/>
   </StackPanel>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
    <Button Content="Matières" Click="Settings_Click" Margin="3"/>
    <Button Content="＋ Nouvelle tâche" Click="NewTask_Click" Background="#657FE8" BorderBrush="#AFC0FF" Margin="3"/>
   </StackPanel>
  </DockPanel>

  <Border Grid.Row="1" CornerRadius="16" BorderThickness="1" BorderBrush="#6686B7E8" Padding="10" Margin="0,0,0,12">
   <Border.Background>
    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
     <GradientStop Color="#A82A3858" Offset="0"/><GradientStop Color="#7819233C" Offset="0.55"/><GradientStop Color="#A8273150" Offset="1"/>
    </LinearGradientBrush>
   </Border.Background>
   <DockPanel>
    <TextBlock Text="Afficher" VerticalAlignment="Center" Foreground="#BBC6E0" Margin="4,0,8,0"/>
    <ComboBox x:Name="ViewBox" Width="110" SelectedIndex="0" SelectionChanged="View_Changed" Margin="0,0,10,0">
     <ComboBoxItem Content="Jour"/><ComboBoxItem Content="Semaine"/><ComboBoxItem Content="Mois"/>
    </ComboBox>
    <DatePicker x:Name="DayPicker" SelectedDateChanged="DayPicker_Changed" Width="150"/>
    <TextBlock Text="Choisis une date, puis coche les tâches terminées." Foreground="#AAB8D8" VerticalAlignment="Center" Margin="14,0,0,0"/>
   </DockPanel>
  </Border>

  <Expander x:Name="NewTaskPanel" Grid.Row="2" Visibility="Collapsed" IsExpanded="True" Margin="0,0,0,12">
   <Border CornerRadius="16" BorderThickness="1" BorderBrush="#6686B7E8" Padding="16">
    <Border.Background>
     <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#A82A3858" Offset="0"/><GradientStop Color="#8E19233C" Offset="1"/>
     </LinearGradientBrush>
    </Border.Background>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="150"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,0,0,10">
      <TextBlock Text="Nouvelle tâche" FontSize="18" FontWeight="SemiBold"/>
      <Button Content="Annuler" Click="CancelNewTask_Click" Margin="12,0,0,0" Padding="9,4"/>
     </StackPanel>
     <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Text="Intitulé" Foreground="#BBC6E0" Margin="0,0,0,4"/>
     <TextBox x:Name="TitleBox" Grid.Row="2" Grid.ColumnSpan="4" ToolTip="Intitulé" Margin="0,0,0,9"/>
     <TextBlock Grid.Row="3" Grid.Column="0" Text="Catégorie" Foreground="#BBC6E0" Margin="0,0,0,4"/>
     <TextBlock Grid.Row="3" Grid.Column="1" Text="Matière" Foreground="#BBC6E0" Margin="0,0,0,4"/>
     <TextBlock Grid.Row="3" Grid.Column="2" Text="Date" Foreground="#BBC6E0" Margin="0,0,0,4"/>
     <TextBlock Grid.Row="3" Grid.Column="3" Text="Heure" Foreground="#BBC6E0" Margin="8,0,0,4"/>
     <ComboBox x:Name="TypeBox" Grid.Row="4" Grid.Column="0" SelectedIndex="0" Margin="0,0,8,0">
      <ComboBoxItem Content="Devoir"/><ComboBoxItem Content="Évaluation"/><ComboBoxItem Content="Cours"/><ComboBoxItem Content="DM"/>
     </ComboBox>
     <ComboBox x:Name="SubjectBox" Grid.Row="4" Grid.Column="1" IsEditable="False" Margin="0,0,8,0"/>
     <DatePicker x:Name="DueDatePicker" Grid.Row="4" Grid.Column="2"/>
     <TextBox x:Name="TimeBox" Grid.Row="4" Grid.Column="3" Margin="8,0,0,0" ToolTip="Facultatif · HH:mm"/>
     <TextBlock Grid.Row="5" Grid.ColumnSpan="4" Text="Description (facultative)" Foreground="#BBC6E0" Margin="0,9,0,4"/>
     <TextBox x:Name="DescriptionBox" Grid.Row="6" Grid.ColumnSpan="4" Margin="0,0,0,0" ToolTip="Description facultative"/>
     <Button Grid.Row="7" Grid.Column="3" Content="Ajouter" Click="Add_Click" Background="#657FE8" BorderBrush="#AFC0FF" Margin="8,10,0,0"/>
    </Grid>
   </Border>
  </Expander>

  <Border Grid.Row="3" x:Name="TasksPanel" CornerRadius="18" BorderThickness="1" BorderBrush="#6686B7E8" Padding="14">
   <Border.Background>
    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
     <GradientStop Color="#902A3858" Offset="0"/><GradientStop Color="#6819233C" Offset="0.55"/><GradientStop Color="#90273150" Offset="1"/>
    </LinearGradientBrush>
   </Border.Background>
   <DockPanel>
    <TextBlock x:Name="RangeText" DockPanel.Dock="Top" Foreground="#AAB8D8" Margin="4,0,0,10"/>
    <Grid>
     <TextBlock x:Name="EmptyState" Text="Rien de prévu pour cette période. Ajoute une tâche pour commencer."
                Foreground="#AAB8D8" HorizontalAlignment="Center" VerticalAlignment="Center"
                TextAlignment="Center" TextWrapping="Wrap" Margin="24"/>
     <ListBox x:Name="AgendaList" Background="Transparent" BorderThickness="0" Foreground="#F5F7FF">
     <ListBox.ItemTemplate><DataTemplate>
      <Border Background="#68151E34" BorderBrush="#456188" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,8">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
         <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"/>
         <TextBlock Text="{Binding DisplaySubtitle}" Foreground="#B8C5D8" Margin="0,3,0,0"/>
         <TextBlock Text="{Binding DueDate, StringFormat={}{0:dddd d MMMM}}" Foreground="#91AAFF" Margin="0,3,0,0"/>
         <TextBlock Text="{Binding DisplayDate}" Foreground="#91AAFF"/>
         <TextBlock Text="{Binding Description}" Foreground="#C1CAD8" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
        <CheckBox Grid.Column="1" IsChecked="{Binding IsDone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  Content="Terminée" VerticalAlignment="Center" Foreground="#D6DDF0" Checked="Done_Changed" Unchecked="Done_Changed" Margin="12"/>
        <Button Grid.Column="2" Content="Supprimer" Click="DeleteItem_Click" VerticalAlignment="Center"
                Padding="8,5" Tag="{Binding}" ToolTip="Supprimer cette tâche"/>
       </Grid>
      </Border>
     </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </Grid>
   </DockPanel>
  </Border>
  <DockPanel Grid.Row="4" Margin="2,12,2,0">
   <TextBlock Text="Enregistrement automatique · stockage local" Foreground="#AAB8D8" VerticalAlignment="Center"/>
   <Button Content="Tableau de bord" Width="130" Click="Close_Click" DockPanel.Dock="Right"/>
  </DockPanel>
 </Grid>
</UserControl>

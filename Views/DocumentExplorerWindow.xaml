<UserControl x:Class="SchoolDesk.Views.DocumentExplorerWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:SchoolDesk.Controls"
             Background="Transparent" Foreground="{StaticResource TextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Explorateur de documents" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Retrouve et organise tes fichiers Word"
                           Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
            </StackPanel>
            <Button DockPanel.Dock="Right" Click="OpenFolder_Click" VerticalAlignment="Center"
                    ToolTip="Ouvrir ce dossier dans l’Explorateur de fichiers">
                <StackPanel Orientation="Horizontal">
                    <icons:SvgIcon Icon="open-folder" Width="16" Height="16"
                                   Stroke="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="Ouvrir le dossier" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="5" Padding="16">
                <StackPanel>
                    <TextBlock Text="Parcourir" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14" />
                    <TextBlock Text="Matière" Foreground="{StaticResource MutedBrush}" />
                    <ComboBox x:Name="SubjectBox" Margin="0,5,0,14"
                              SelectionChanged="Location_Changed" />
                    <TextBlock Text="Catégorie" Foreground="{StaticResource MutedBrush}" />
                    <ComboBox x:Name="TypeBox" Margin="0,5,0,18" SelectedIndex="0"
                              SelectionChanged="Location_Changed">
                        <ComboBoxItem Content="Cours" />
                        <ComboBoxItem Content="Devoir" />
                        <ComboBoxItem Content="Évaluation" />
                        <ComboBoxItem Content="DM" />
                    </ComboBox>
                    <Border Background="{StaticResource SubtleSurfaceBrush}" CornerRadius="4" Padding="10">
                        <StackPanel>
                            <TextBlock Text="Emplacement local" FontWeight="SemiBold" FontSize="12" />
                            <TextBlock x:Name="FolderText" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="5" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Documents" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Name="CountText" Text="0 fichier"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="OpenButton" Click="OpenDocument_Click" IsEnabled="False"
                                    Margin="0,0,8,0" Style="{StaticResource PrimaryButtonStyle}"
                                    ToolTip="Ouvrir le document sélectionné dans l’éditeur">
                                <StackPanel Orientation="Horizontal">
                                    <icons:SvgIcon Icon="document" Width="16" Height="16"
                                                   Stroke="White" Margin="0,0,8,0" />
                                    <TextBlock Text="Ouvrir" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="DeleteButton" Click="DeleteSelected_Click" IsEnabled="False"
                                    Style="{StaticResource DangerButtonStyle}"
                                    ToolTip="Envoyer le document sélectionné dans la Corbeille">
                                <StackPanel Orientation="Horizontal">
                                    <icons:SvgIcon Icon="delete" Width="16" Height="16"
                                                   Stroke="#A12B24" Margin="0,0,8,0" />
                                    <TextBlock Text="Supprimer" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>

                    <Border Grid.Row="1" Background="{StaticResource WindowBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="9" Margin="0,0,0,12">
                        <DockPanel>
                            <icons:SvgIcon Icon="search" Width="17" Height="17"
                                           Stroke="{StaticResource MutedBrush}" Margin="0,0,8,0"
                                           VerticalAlignment="Center" />
                            <TextBox x:Name="SearchBox" BorderThickness="0" MinHeight="24" Padding="0"
                                     Background="Transparent" ToolTip="Filtrer par nom de fichier"
                                     AutomationProperties.Name="Rechercher un document"
                                     TextChanged="Search_Changed" />
                        </DockPanel>
                    </Border>

                    <Grid Grid.Row="2">
                        <ListBox x:Name="FilesList" BorderThickness="0" Background="Transparent"
                                 MouseDoubleClick="FilesList_DoubleClick"
                                 SelectionChanged="FilesList_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="{x:Type ListBoxItem}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="10,9" />
                                    <Setter Property="Margin" Value="0,0,0,6" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                <Border x:Name="ItemSurface" Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemSurface" Property="Background" Value="#F4F6F8" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemSurface" Property="Background" Value="{StaticResource AccentSubtleBrush}" />
                                                        <Setter TargetName="ItemSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="ItemSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="38" Height="42" Background="{StaticResource AccentSubtleBrush}"
                                                CornerRadius="4" VerticalAlignment="Center">
                                            <icons:SvgIcon Icon="document" Width="20" Height="20"
                                                           Stroke="{StaticResource AccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,8,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Modified}" FontSize="12"
                                                       Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Size}" FontSize="12"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center"
                                    VerticalAlignment="Center" MaxWidth="320" IsHitTestVisible="False"
                                    Visibility="Collapsed">
                            <icons:SvgIcon Icon="document" Width="32" Height="32"
                                           Stroke="{StaticResource MutedBrush}" Opacity="0.7"
                                           HorizontalAlignment="Center" Margin="0,0,0,12" />
                            <TextBlock x:Name="EmptyText" Text="Aucun document dans cette catégorie."
                                       Foreground="{StaticResource MutedBrush}" TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="2,12,2,0">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center" />
            <Button Content="Tableau de bord" Click="Close_Click" Width="140"
                    DockPanel.Dock="Right" />
        </DockPanel>
    </Grid>
</UserControl>

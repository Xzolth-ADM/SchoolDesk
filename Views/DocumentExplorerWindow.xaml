<UserControl x:Class="SchoolDesk.Views.DocumentExplorerWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" Foreground="{StaticResource TextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Explorateur de documents" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Parcourir les fichiers Word enregistrés sur cet appareil"
                           Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Content="Ouvrir le dossier" DockPanel.Dock="Right" Click="OpenFolder_Click"
                    Padding="14,8" VerticalAlignment="Center" />
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="5" Padding="16">
                <StackPanel>
                    <TextBlock Text="Matière" Foreground="{StaticResource MutedBrush}" />
                    <ComboBox x:Name="SubjectBox" Margin="0,5,0,16"
                              SelectionChanged="Location_Changed" />
                    <TextBlock Text="Catégorie" Foreground="{StaticResource MutedBrush}" />
                    <ComboBox x:Name="TypeBox" Margin="0,5,0,16" SelectedIndex="0"
                              SelectionChanged="Location_Changed">
                        <ComboBoxItem Content="Cours" />
                        <ComboBoxItem Content="Devoir" />
                        <ComboBoxItem Content="Évaluation" />
                        <ComboBoxItem Content="DM" />
                    </ComboBox>
                    <TextBlock x:Name="FolderText" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="5" Padding="16">
                <DockPanel>
                    <TextBlock x:Name="EmptyText"
                               Text="Sélectionne une matière pour afficher les documents DOCX."
                               Foreground="{StaticResource MutedBrush}" DockPanel.Dock="Top"
                               Margin="0,0,0,10" />
                    <ListBox x:Name="FilesList" MouseDoubleClick="FilesList_DoubleClick" />
                </DockPanel>
            </Border>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center" />
            <Button Content="Ouvrir dans l’éditeur" Click="OpenDocument_Click" Width="170"
                    Height="36" DockPanel.Dock="Right" Style="{StaticResource PrimaryButtonStyle}" />
        </DockPanel>
    </Grid>
</UserControl>

<UserControl x:Class="SchoolDesk.Views.DocumentExplorerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="Transparent" Foreground="#F4F6FB">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,16">
   <StackPanel><TextBlock Text="SCHOOLDESK / BIBLIOTHÈQUE LOCALE" Foreground="#9EABC0"/><TextBlock Text="Explorateur de documents" FontSize="29" FontWeight="SemiBold" Margin="0,5"/></StackPanel>
   <Button Content="Ouvrir le dossier" DockPanel.Dock="Right" Click="OpenFolder_Click" Padding="14,8" VerticalAlignment="Center"/>
  </DockPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource GlassSurfaceBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="14">
    <StackPanel>
     <TextBlock Text="Matière" Foreground="#AAB5C7"/><ComboBox x:Name="SubjectBox" Margin="0,5,0,14" SelectionChanged="Location_Changed"/>
     <TextBlock Text="Catégorie" Foreground="#AAB5C7"/><ComboBox x:Name="TypeBox" Margin="0,5,0,14" SelectedIndex="0" SelectionChanged="Location_Changed">
      <ComboBoxItem Content="Cours"/><ComboBoxItem Content="Devoir"/><ComboBoxItem Content="Évaluation"/><ComboBoxItem Content="DM"/>
     </ComboBox>
     <TextBlock x:Name="FolderText" TextWrapping="Wrap" Foreground="#8492A9"/>
    </StackPanel>
   </Border>
   <Border Grid.Column="2" Background="{StaticResource GlassSurfaceBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="14">
    <DockPanel>
     <TextBlock x:Name="EmptyText" Text="Sélectionne une matière pour afficher les documents DOCX." Foreground="#AAB5C7" DockPanel.Dock="Top" Margin="0,0,0,10"/>
     <ListBox x:Name="FilesList" Background="#202C40" Foreground="White" BorderThickness="0" MouseDoubleClick="FilesList_DoubleClick"/>
    </DockPanel>
   </Border>
  </Grid>
  <DockPanel Grid.Row="2" Margin="0,14,0,0">
   <TextBlock x:Name="StatusText" Foreground="#9EABC0" VerticalAlignment="Center"/>
   <Button Content="Ouvrir dans l'éditeur" Click="OpenDocument_Click" Width="160" Height="36" DockPanel.Dock="Right" Background="#637FF0" Foreground="White"/>
  </DockPanel>
 </Grid>
</UserControl>

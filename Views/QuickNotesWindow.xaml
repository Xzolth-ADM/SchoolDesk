<UserControl x:Class="SchoolDesk.Views.QuickNotesWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" Foreground="{StaticResource TextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Notes rapides" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Vos notes restent sur cet appareil"
                       Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="5" Padding="10">
            <TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                     Background="{StaticResource SurfaceBrush}" BorderThickness="0"
                     Padding="14" FontSize="15" TextChanged="NotesBox_Changed" />
        </Border>
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center" />
            <Button Content="Tableau de bord" Click="Close_Click" Width="140"
                    Height="36" DockPanel.Dock="Right" Margin="0,0,8,0" />
            <Button Content="Enregistrer" Click="Save_Click" Width="110" Height="36"
                    DockPanel.Dock="Right" Style="{StaticResource PrimaryButtonStyle}" />
        </DockPanel>
    </Grid>
</UserControl>

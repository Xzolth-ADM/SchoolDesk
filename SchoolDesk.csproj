<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SchoolDesk</AssemblyName>
    <RootNamespace>SchoolDesk</RootNamespace>
    <Version>0.5.2</Version>
  </PropertyGroup>
  <ItemGroup>
    <None Update="Assets\schedule.json" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Assets\schooldesk-icons.svg" LogicalName="SchoolDesk.Assets.schooldesk-icons.svg" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SchoolDesk</AssemblyName>
    <RootNamespace>SchoolDesk</RootNamespace>
    <Version>0.5.4</Version>
    <ApplicationIcon>Assets\image_1_.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <None Remove="Assets\schedule.json" />
    <Content Include="Assets\schedule.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true" />
    <Resource Include="Assets\image_1_.ico" />
    <EmbeddedResource Include="Assets\schooldesk-icons.svg" LogicalName="SchoolDesk.Assets.schooldesk-icons.svg" />
  </ItemGroup>
</Project>
